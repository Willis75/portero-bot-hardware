#!/bin/sh
# Rechaza el commit si un .py staged trae un escape roto en una cadena.
#
# Por que solo ESTE chequeo y no run_arneses entero: la bateria completa tarda ~20 s y un
# hook lento se vuelve `--no-verify` por costumbre, que es peor que no tenerlo. Este mira
# unicamente los .py staged y tarda decimas.
#
# Que caza (detalle en el propio arnes):
#   1. escape invalido ('\C', '\All'): avisa, y escalado a error ciega a otros arneses.
#   2. escape VALIDO que se comio una letra ('\b' = backspace): NO avisa. El 06-sep-2026
#      habia tres, uno de ellos en la ruta de un comando que viajaba por SSH.
#
# Lee del INDICE (git show :ruta), no del disco: lo que se commitea es el indice.
# Saltarlo: git commit --no-verify

# En rebase/merge/cherry-pick no hay nada que juzgar: el contenido no lo escribio nadie ahora.
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

RAIZ=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# RC-300: el repo no puede guardar un runner de Bill armado para enviar a clientes (21-sep-2026).
# Va ANTES de todo lo demas porque los bloques de abajo salen con `exit 0` cuando no hay .py
# staged, y lo que este cuida son .cmd. Solo en HAF: en los otros repos el script no existe.
CHECK_ENVIO="$RAIZ/ops/check_envio_bill_apagado.py"
if [ -f "$CHECK_ENVIO" ]; then
    PY_E=$(command -v python 2>/dev/null || command -v python3 2>/dev/null)
    if [ -n "$PY_E" ]; then
        SALIDA_E=$("$PY_E" "$CHECK_ENVIO" 2>&1)
        if [ $? -ne 0 ]; then
            echo "$SALIDA_E"
            echo ""
            echo "  pre-commit: envio de Bill armado en un runner. Commit RECHAZADO."
            echo "  Encender el envio es decision del usuario: se cambia ENVIO_BILL en el mismo commit."
            exit 1
        fi
    fi
fi

# RC-NNN: amarre codigo<->matriz, provisional (T-4C.6, 21-sep-2026; extendido a Bill en T-4B.3,
# ex check_rc_cony.py). Va DESPUES de RC-300 (Bill) y ANTES del arnes de escapes: dispara si hay
# algo staged bajo cony/, reglas/, scripts/ u ops/ (desde T-4B.2 la matriz cita lineas de
# scripts/*.py y ops/*.py, incluidos bill_*.py/emailer.py: editar ahi corre las citas en silencio
# si el check no mira), y ademas corre los 9 arneses de cony/ (ops/run_arneses.py --solo cony)
# SOLO cuando lo staged toca cony/ -- un cambio en reglas/matriz.md o en scripts/ no reejecuta
# arneses que no cambiaron (hook lento = --no-verify).
CHECK_RC="$RAIZ/reglas/check_rc.py"
if [ -f "$CHECK_RC" ]; then
    # Incluye D: borrar reglas/matriz.md o deuda.txt tambien debe pasar por la puerta (falla cerrado).
    if git diff --cached --name-only --diff-filter=ACMD | grep -qE '^(cony|reglas|scripts|ops)/'; then
        PY_RC=$(command -v python 2>/dev/null || command -v python3 2>/dev/null)
        if [ -n "$PY_RC" ]; then
            SALIDA_RC=$("$PY_RC" "$CHECK_RC" 2>&1)
            if [ $? -ne 0 ]; then
                echo "$SALIDA_RC"
                echo ""
                echo "  pre-commit: reglas/check_rc.py encontro hallazgos. Commit RECHAZADO."
                echo "  Saltarlo (solo si sabes por que): git commit --no-verify"
                exit 1
            fi
            if git diff --cached --name-only --diff-filter=ACM | grep -qE '^cony/'; then
                RUNNER_RC="$RAIZ/ops/run_arneses.py"
                if [ -f "$RUNNER_RC" ]; then
                    SALIDA_ARNES_CONY=$("$PY_RC" "$RUNNER_RC" --solo cony 2>&1)
                    if [ $? -ne 0 ]; then
                        echo "$SALIDA_ARNES_CONY"
                        echo ""
                        echo "  pre-commit: ops/run_arneses.py --solo cony revento. Commit RECHAZADO."
                        echo "  Saltarlo (solo si sabes por que): git commit --no-verify"
                        exit 1
                    fi
                fi
            fi
        fi
    fi
fi

# El arnes se busca en varios sitios porque este hook vive en cinco repos con layouts
# distintos (intelliagency no tiene scripts/, el vault tampoco). Fijar una sola ruta
# significaba que en el repo equivocado el hook salia por el `exit 0` de abajo y NO
# vigilaba nada, en silencio y con cara de instalado.
ARNES=""
for CAND in "$RAIZ/scripts/test_escapes_validos.py" \
            "$RAIZ/ops/test_escapes_validos.py" \
            "$RAIZ/tools/test_escapes_validos.py" \
            "$RAIZ/test_escapes_validos.py"; do
    [ -f "$CAND" ] && { ARNES="$CAND"; break; }
done

# Si el arnes no esta (rama vieja, checkout parcial), no se bloquea el commit: este hook
# vigila escapes, no la integridad del repo. run_arneses ya reporta DESAPARECIDO.
[ -f "$ARNES" ] || exit 0

git diff --cached --name-only --diff-filter=ACM | grep -q '\.py$' || exit 0

PY=$(command -v python 2>/dev/null || command -v python3 2>/dev/null)
[ -n "$PY" ] || exit 0

SALIDA=$("$PY" "$ARNES" --desde-git 2>&1)
if [ $? -ne 0 ]; then
    echo "$SALIDA"
    echo ""
    echo "  pre-commit: escape roto en un .py staged. Commit RECHAZADO."
    echo "  Saltarlo (solo si sabes por que): git commit --no-verify"
    exit 1
fi

# Barrido de escritores sin guarda (A1, revision Fable ronda 3, 19-sep-2026) -- solo en el repo
# HAF (donde vive ops/barrido_escritores.py; los otros 5 repos que comparten este hook -- camaras,
# envasado-liquidos-hardware, intelliagency, portero-bot-hardware, claustro4-acceso -- no tienen
# CONTPAQi ni esta guarda, asi que ahi el bloque de abajo sale por el mismo `[ -f ... ] || exit 0`
# de arriba que ya cubre "el arnes no esta"). A diferencia del chequeo de escapes, este SI lee
# de disco (no del indice): es un invariante sobre el arbol completo, no un diff por archivo, y
# el barrido en si (`ops/test_freno_periodo.py`) ya trabaja asi desde el 19-sep-2026.
BARRIDO="$RAIZ/ops/barrido_escritores.py"
if [ -f "$BARRIDO" ]; then
    SALIDA_B=$("$PY" "$BARRIDO" 2>&1)
    if [ $? -ne 0 ]; then
        echo "$SALIDA_B"
        echo ""
        echo "  pre-commit: escritor sin guarda de host+periodo. Commit RECHAZADO."
        echo "  Saltarlo (solo si sabes por que): git commit --no-verify"
        exit 1
    fi
fi

exit 0
